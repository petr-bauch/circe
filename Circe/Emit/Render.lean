def emitUseNsAddText (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}` (delegates to the `_ZN2ns3addEii` namespaced body). -/\n"
  ++ s!"def {name}_fwd (x y : BitVec 32) : Result (BitVec 32) :=\n"
