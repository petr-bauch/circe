def emitOptDerefText (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}` (guarded deref: word on engaged, `-1` sentinel otherwise). -/\n"
  ++ s!"def {name}_fwd (o : Option (BitVec 32)) : Result (BitVec 32) :=\n"
  ++ "  match o with\n"
  ++ "  | some x => .ok x\n"
  ++ "  | none => .ok (-1)\n"

