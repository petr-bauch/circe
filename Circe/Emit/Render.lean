/-
Circe.Emit.Render — rendering of accepted fragments to Lean file text.

Pure string functions only (no CoreIR/Eval dependency): one `emit*Text`
per shape plus the `emitForwardText`/`emitFileText` projections used by the
golden linkage in `Circe.Emit`. Trusted pretty-printing; the semantics are
pinned by the `emit_correct` proofs in the fragment modules.
-/

/-! ## Rendering to Lean file text -/

/-- Emission failures: only "not in the admitted fragment" exists
    (oracle/aliasing rejections live in `validate`). -/
inductive EmitError : Type
  | notFragment : String → EmitError
  deriving DecidableEq, Repr

/-- Emitted Lean code for one function: forward definition file text, plus
    an optional backward definition for borrow-returns (`choose`-shape,
    Phase 4). -/
structure EmittedFunc : Type where
  forward : String
  backward : Option String
  deriving DecidableEq, Repr

/-- File header shared by all rendered outputs. -/
def emitHeader : String :=
  "-- Generated by the Circe emitter (Phase 4) from validated CoreIR. Do not edit.\n"
  ++ "-- Emitter correctness (`Circe.Emit.emit_correct_add/incr/choose/sum`):\n"
  ++ "-- this file is the tag-erased rendering of the verified forward function\n"
  ++ "-- (value tags dropped; pretty-printing is trusted, semantics verified).\n"
  ++ "-- Checked by `lake env lean`; see `tools/check-phase4.sh`.\n"

/-- Render the `add` forward definition (`add_fwd`). -/
def emitAddText (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}`: values in, value out (no memory). -/\n"
  ++ s!"def {name}_fwd (a b : BitVec 32) : Result (BitVec 32) :=\n"
  ++ "  checkedAddI32 a b\n"

/-- Render the `incr` forward definition (`incr_fwd`), with the
    caller-side rewrite in the doc comment. -/
def emitIncrText (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}` (`*p = *p + 1`, functionalized).\n"
  ++ s!"    Caller rewrite: `incr(&y)` becomes `y ← {name}_fwd y`. -/\n"
  ++ s!"def {name}_fwd (p : BitVec 32) : Result (BitVec 32) :=\n"
  ++ "  checkedIncrI32 p\n"

/-- Render the `reborrow` forward definition (`reborrow_fwd`), with
    the caller-side rewrite in the doc comment: two sequential
    checked adds (`*x += 1`, then `*x += 2`), fail-fast. -/
def emitReborrowText (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}` (`*x += 1`, then `*x += 2` through sequential reborrows, functionalized).\n"
  ++ s!"    Caller rewrite: `reborrow(&y)` becomes `y ← {name}_fwd y`. -/\n"
  ++ s!"def {name}_fwd (x : BitVec 32) : Result (BitVec 32) :=\n"
  ++ "  match checkedAddI32 x 1 with\n"
  ++ "  | .error e => .error e\n"
  ++ "  | .ok t => checkedAddI32 t 2\n"

/-- Render the `reborrow34` forward definition (`reborrow34_fwd`),
    same shape as `reborrow` with the `3`/`4` consts. -/
def emitReborrow34Text (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}` (`*x += 3`, then `*x += 4` through sequential reborrows, functionalized).\n"
  ++ s!"    Caller rewrite: `reborrow34(&y)` becomes `y ← {name}_fwd y`. -/\n"
  ++ s!"def {name}_fwd (x : BitVec 32) : Result (BitVec 32) :=\n"
  ++ "  match checkedAddI32 x 3 with\n"
  ++ "  | .error e => .error e\n"
  ++ "  | .ok t => checkedAddI32 t 4\n"

/-- Render the `wr_pair` forward definition (`wr_pair_fwd`), with the
    caller-side rewrite in the doc comment: two disjoint checked adds
    (`*p += 1`, `*q += 2`), fail-fast first-add-first. The pair is
    tag-erased to `(BitVec 32 × BitVec 32)` (the `IPair` structVal
    with tags dropped, like every rendered forward). -/
def emitWrPairText (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}` (`*p += 1`, `*q += 2` over two disjoint cells, functionalized).\n"
  ++ s!"    Caller rewrite: `(p, q) ← {name}_fwd p q`, writing both words back. -/\n"
  ++ s!"def {name}_fwd (p q : BitVec 32) : Result (BitVec 32 × BitVec 32) :=\n"
  ++ "  match checkedAddI32 p 1, checkedAddI32 q 2 with\n"
  ++ "  | .ok a, .ok b => .ok (a, b)\n"
  ++ "  | .error e, _ => .error e\n"
  ++ "  | _, .error e => .error e\n"

/-- Render the `cond_pair` forward definition (`cond_pair_fwd`):
    branch-masked first add plus the unconditional second add
    (body order: branch first). Tag-erased pair as in G2. -/
def emitCondPairText (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}` (`*p += 1` under `c`, `*q += 2` always, over two disjoint cells, functionalized).\n"
  ++ s!"    Caller rewrite: `(a, b) ← {name}_fwd p q c`, writing both words back. -/\n"
  ++ s!"def {name}_fwd (p q : BitVec 32) (c : Bool) : Result (BitVec 32 × BitVec 32) :=\n"
  ++ "  match c with\n"
  ++ "  | true =>\n"
  ++ "    match checkedAddI32 p 1 with\n"
  ++ "    | .error e => .error e\n"
  ++ "    | .ok a =>\n"
  ++ "      match checkedAddI32 q 2 with\n"
  ++ "      | .error e => .error e\n"
  ++ "      | .ok b => .ok (a, b)\n"
  ++ "  | false =>\n"
  ++ "    match checkedAddI32 q 2 with\n"
  ++ "    | .error e => .error e\n"
  ++ "    | .ok b => .ok (p, b)\n"

/-- Render the `alias_cond` open-contract spec (`{name}_spec`): no
    pure `(p,q,c)` translation is sound (G2 — the `q` re-read
    observes `p`'s write), so the caller supplies `aliased` (`true`
    when both params address one cell). Taken-branch under
    aliasing runs the second addition on the stored value and the
    second store wins, so both words read back the `q` result; the
    masked leg reads the shared cell (`p`) under aliasing, so both
    words read back that result too. -/
def emitAliasCondText (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Open-contract spec of `{name}` (`if (c) *p += 1; *q += 2` over caller-aliased cells).\n"
  ++ s!"    Caller supplies `aliased`; caller rewrite writes both words back. -/\n"
  ++ s!"def {name}_spec (p q : BitVec 32) (c aliased : Bool) : Result (BitVec 32 × BitVec 32) :=\n"
  ++ "  match c with\n"
  ++ "  | true =>\n"
  ++ "    match checkedAddI32 p 1 with\n"
  ++ "    | .error e => .error e\n"
  ++ "    | .ok a =>\n"
  ++ "      let q' := if aliased then a else q\n"
  ++ "      match checkedAddI32 q' 2 with\n"
  ++ "      | .error e => .error e\n"
  ++ "      | .ok b => .ok (if aliased then (b, b) else (a, b))\n"
  ++ "  | false =>\n"
  ++ "    let q' := if aliased then p else q\n"
  ++ "    match checkedAddI32 q' 2 with\n"
  ++ "    | .error e => .error e\n"
  ++ "    | .ok b => .ok (if aliased then (b, b) else (p, b))\n"

/-- Render the `add64` forward definition (`add64_fwd`, S3b). -/
def emitAdd64Text (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}`: values in, value out (no memory). -/\n"
  ++ s!"def {name}_fwd (a b : BitVec 64) : Result (BitVec 64) :=\n"
  ++ "  checkedAddI64 a b\n"

/-- Render the `addu64` forward definition (`addu64_fwd`, S3b:
    wrapping unsigned addition, never fails). -/
def emitAddu64Text (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}` (wrapping `u64` addition). -/\n"
  ++ s!"def {name}_fwd (a b : BitVec 64) : Result (BitVec 64) :=\n"
  ++ "  .ok (a + b)\n"

/-- Render the `neg` forward definition (`neg_fwd`, N6a: signed-32
    negation, `INT_MIN` overflows). -/
def emitNegText (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}`: value in, value out (no memory). -/\n"
  ++ s!"def {name}_fwd (x : BitVec 32) : Result (BitVec 32) :=\n"
  ++ "  checkedNegI32 x\n"

/-- Render the `sdiv` forward definition (`sdiv_fwd`, N6a: signed-32
    division, `DivZero` + `INT_MIN / -1` overflow). -/
def emitSdivText (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}`: values in, value out (no memory). -/\n"
  ++ s!"def {name}_fwd (a b : BitVec 32) : Result (BitVec 32) :=\n"
