  ++ s!"/-- Pure translation of `{name}` (delegates to the `_Z3addii` overload body). -/\n"
  ++ s!"def {name}_fwd (x y : BitVec 32) : Result (BitVec 32) :=\n"
  ++ "  checkedAddI32 x y\n"

/-- Render the `use_ns_add` entry forward definition: direct delegation
