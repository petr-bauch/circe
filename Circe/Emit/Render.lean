    dropped). -/
def emitOptImplGetText (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}` (delegates to the payload `_M_get` word body). -/\n"
  ++ s!"def {name}_fwd (o : Option (BitVec 32)) : Result (BitVec 32) :=\n"
