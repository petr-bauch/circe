  ++ s!"/-- Pure translation of `{name}` (delegates to the `_Z4taddIiET_S0_S0_` instantiation body). -/\n"
  ++ s!"def {name}_fwd (x y : BitVec 32) : Result (BitVec 32) :=\n"
