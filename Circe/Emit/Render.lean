def emitUseTadd64Text (name : String) : String :=
  emitHeader
  ++ "\nimport Circe.Base\n\n"
  ++ s!"/-- Pure translation of `{name}` (delegates to the `_Z4taddIlET_S0_S0_` instantiation body). -/\n"
  ++ s!"def {name}_fwd (x y : BitVec 64) : Result (BitVec 64) :=\n"
